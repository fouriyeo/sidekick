  "transitions": [
    {
      "from": "*",
      "on": "task:start",
      "to": "working"
    },
    {
      "from": "*",
      "on": "task:need-approval",
      "to": "attention"
    },
    {
      "from": "attention",
      "on": "task:approved",
      "to": "working"
    },
    {
      "from": "*",
      "on": "task:completed",
      "to": "done"
    },
    {
      "from": "done",
      "on": "$finish",
      "to": "idle"
    },
    {
      "from": "*",
      "on": "$reset",
      "to": "idle"
    }
  ]
